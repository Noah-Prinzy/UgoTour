{
  "name": "ugotour",
  "version": "1.0.0",
  "private": true,
  "description": "UgoTour production-ready Uganda tourism PWA with vanilla JavaScript, Node.js REST API and PostgreSQL",
  "scripts": {
    "start:backend": "node backend/start.js",
    "assets:download": "node scripts/download-images.js",
    "assets:verify": "node scripts/verify-images.js",
    "map:verify": "node backend/src/database/verify-map-data.js",
    "assets:optimize": "python scripts/optimize-images.py",
    "seo:build": "node scripts/build-seo.js",
    "predeploy:check": "node scripts/predeploy-check.js",
    "backend:check": "npm --prefix backend run check",
    "admin:grant": "npm --prefix backend run admin:grant --",
    "security:smoke": "node scripts/security-smoke.js",
    "db:bootstrap:production": "npm --prefix backend run db:bootstrap:production"
  },
  "type": "module"
}
