{
  "name": "UgoTour — Explore Uganda",
  "short_name": "UgoTour",
  "description": "A JavaScript-first Uganda tourism PWA for discovering, mapping, saving and planning journeys.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3f0e7",
  "theme_color": "#172114",
  "orientation": "any",
  "icons": [
    {
      "src": "./assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Explore Map",
      "short_name": "Map",
      "description": "Open the interactive Uganda tourism map.",
      "url": "./pages/map.html",
      "icons": [
        {
          "src": "./assets/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Destinations",
      "short_name": "Explore",
      "description": "Browse UgoTour destinations.",
      "url": "./pages/destinations.html",
      "icons": [
        {
          "src": "./assets/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Saved Places",
      "short_name": "Saved",
      "description": "Open your saved Uganda destinations and attractions.",
      "url": "./pages/saved.html",
      "icons": [
        {
          "src": "./assets/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
