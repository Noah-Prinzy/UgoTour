# UgoTour backend environment
APP_ENV=development
HOST=127.0.0.1
PORT=3000

# PostgreSQL. Prefer DATABASE_URL on deployment platforms.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ugotour_db
DB_USER=ugotour_user
DB_PASSWORD=change-me
DB_SSL=false

# Frontend origins allowed to send credentialed API requests.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# HttpOnly session cookie
# In production, leave SESSION_COOKIE_NAME blank to use the host-only __Host- cookie default,
# or explicitly set a secure name. Development defaults to ugotour_session.
SESSION_COOKIE_NAME=
SESSION_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
# Keep blank when using a __Host- cookie.
COOKIE_DOMAIN=

# Public frontend URL used in password-reset emails
PUBLIC_APP_URL=http://127.0.0.1:5500

# Optional Resend email delivery for password reset.
# When these are blank in development, the reset URL is printed in the backend terminal.
RESEND_API_KEY=
PASSWORD_RESET_FROM=UgoTour <noreply@example.com>

# Request security
MAX_JSON_BODY_BYTES=900000
GENERAL_RATE_LIMIT_PER_MINUTE=180
AUTH_RATE_LIMIT_PER_15_MINUTES=20
CONTACT_RATE_LIMIT_PER_HOUR=10
TRUST_PROXY=false
